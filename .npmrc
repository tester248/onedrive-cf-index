strict-peer-dependencies=false
# pnpm 9.7+ blocks git-hosted subdependencies by default (e.g. webworkify-webpack used by mpegts.js). Relax the policy so installs succeed.
block-exotic-subdeps=false
# Allow postinstall scripts (esbuild, workerd, sharp, etc.) to run, matching the behavior of older pnpm versions.
dangerously-allow-all-builds=true
